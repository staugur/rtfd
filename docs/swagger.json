{
    "schemes": [
        "http",
        "https"
    ],
    "swagger": "2.0",
    "info": {
        "description": "rtfd 是自托管的 Sphinx 文档构建与托管服务，本文档描述其 HTTP API（版本号与 assets/VERSION 保持一致）。\n所有接口挂 /rtfd 前缀，响应统一为 {\"success\":bool,\"message\":string,\"data\":any}，\n业务错误同样以该结构返回（HTTP 200），由 customHTTPErrorHandler 统一处理。\n鉴权：管理接口（项目管理、配置查询、导入导出）与项目级接口（详情/更新/删除/导出）采用 HMAC-SHA256 动态签名，\n需随请求携带 X-Rtfd-Ts（Unix 秒）、X-Rtfd-Nonce（随机串）、X-Rtfd-Sign（HMAC-SHA256 签名）三个头；\n签名串 = ts + \"\\n\" + nonce（以 secret 为 HMAC 密钥，与 method/path/body 无关），密钥为 [api] secret 或项目 secret（二者其一即可）。\n可使用 `rtfd sign` 命令生成签名，或在 Swagger UI 首页填入密钥后自动签名；构建与 webhook 接口使用项目 secret（HMAC/Token）。\n多数接口兼容两种路径风格：/rtfd/{name}/xxx 与 /rtfd/xxx/{name}（文档只列出前者）。",
        "title": "Rtfd API",
        "contact": {},
        "license": {
            "name": "Apache-2.0",
            "url": "http://www.apache.org/licenses/LICENSE-2.0"
        },
        "version": "2.0.0"
    },
    "host": "localhost:5000",
    "basePath": "/",
    "paths": {
        "/rtfd/github/app": {
            "post": {
                "description": "接收 installation / installation_repositories 事件（需 header X-GitHub-Hook-Installation-Target-Type=integration），\n校验 App ID 后同步项目 meta 与仓库级 webhook",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "webhook"
                ],
                "summary": "GitHub App 事件回调",
                "responses": {
                    "200": {
                        "description": "处理成功",
                        "schema": {
                            "$ref": "#/definitions/api.res"
                        }
                    },
                    "default": {
                        "description": "事件类型、目标类型或 App ID 校验失败",
                        "schema": {
                            "$ref": "#/definitions/api.res"
                        }
                    }
                }
            }
        },
        "/rtfd/import": {
            "post": {
                "security": [
                    {
                        "RtfdSign": []
                    }
                ],
                "description": "导入 base64 编码的项目配置（由导出接口或 CLI `rtfd project transfer -e` 生成）；\nname 可选，用于改名导入（缺省取配置中的名称）；导入走创建流程，会重新校验并渲染 nginx。需管理密钥。",
                "consumes": [
                    "application/x-www-form-urlencoded"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "项目管理"
                ],
                "summary": "导入项目配置",
                "parameters": [
                    {
                        "type": "string",
                        "description": "base64 编码的项目配置",
                        "name": "export",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "新项目名称，缺省用配置中的名称",
                        "name": "name",
                        "in": "formData"
                    }
                ],
                "responses": {
                    "201": {
                        "description": "data.name 为导入后的项目名",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/api.resd"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/api.importData"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "default": {
                        "description": "配置非法、名称已存在或密钥校验失败",
                        "schema": {
                            "$ref": "#/definitions/api.res"
                        }
                    }
                }
            }
        },
        "/rtfd/projects": {
            "get": {
                "security": [
                    {
                        "RtfdSign": []
                    }
                ],
                "description": "返回全部项目名称；verbose=1 时返回完整项目配置数组。需管理密钥。",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "项目管理"
                ],
                "summary": "项目列表",
                "parameters": [
                    {
                        "type": "string",
                        "description": "为 true/on/1 时返回完整配置（[]lib.OptionsWithResult）",
                        "name": "verbose",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "项目名称数组；verbose 时为完整配置数组",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/api.resd"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            }
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "default": {
                        "description": "密钥未配置或校验失败",
                        "schema": {
                            "$ref": "#/definitions/api.res"
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "RtfdSign": []
                    }
                ],
                "description": "参数与 CLI `rtfd project create` 一致：url 必需，其余字段可选、空值沿用系统默认；创建后自动渲染 nginx 配置。\n参数可放在表单、query 或 JSON body（键不区分大小写）；需管理密钥。",
                "consumes": [
                    "application/x-www-form-urlencoded"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "项目管理"
                ],
                "summary": "创建项目",
                "parameters": [
                    {
                        "type": "string",
                        "description": "项目名称（仅小写字母数字与-_.）",
                        "name": "name",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "git 仓库地址（https 或 ssh）",
                        "name": "url",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "分支或tag，缺省用系统 default_branch",
                        "name": "latest",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "Python 版本（需在 [py] 分区中定义，如 3.10）",
                        "name": "version",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "语言，多个用英文逗号分隔，如 zh_CN,en",
                        "name": "lang",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "是否单一版本（true/false）",
                        "name": "single",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "文档源目录，默认 docs",
                        "name": "sourcedir",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "依赖文件相对路径（相对文档源目录）",
                        "name": "requirement",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "是否安装依赖（true/false）",
                        "name": "install",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "pip 源索引地址",
                        "name": "index",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "Sphinx 构建器：html/dirhtml/singlehtml",
                        "name": "builder",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "项目密钥（构建与 webhook 签名用）",
                        "name": "secret",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "自定义域名（需已解析到本机）",
                        "name": "domain",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "自定义域名证书路径（与 sslkey 成对）",
                        "name": "sslcrt",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "自定义域名证书私钥路径（与 sslcrt 成对）",
                        "name": "sslkey",
                        "in": "formData"
                    }
                ],
                "responses": {
                    "201": {
                        "description": "创建成功，data 为项目配置",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/api.resd"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/lib.Options"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "default": {
                        "description": "参数非法、名称/自定义域名已存在或密钥校验失败",
                        "schema": {
                            "$ref": "#/definitions/api.res"
                        }
                    }
                }
            }
        },
        "/rtfd/{name}/badge": {
            "get": {
                "description": "返回 SVG 状态徽章（passing/failing/unknown），可直接内嵌到 README。无需鉴权。\n路径别名：GET /rtfd/badge/{name}",
                "produces": [
                    "image/svg+xml"
                ],
                "tags": [
                    "挂件"
                ],
                "summary": "文档状态徽章",
                "parameters": [
                    {
                        "type": "string",
                        "description": "项目名称",
                        "name": "name",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "分支或tag，缺省用项目最新版本；latest 亦表示最新版本",
                        "name": "branch",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "SVG 内容",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "default": {
                        "description": "查询构建结果失败",
                        "schema": {
                            "$ref": "#/definitions/api.res"
                        }
                    }
                }
            }
        },
        "/rtfd/{name}/build": {
            "post": {
                "security": [
                    {
                        "RtfdSign": []
                    }
                ],
                "description": "异步触发指定项目的文档构建，接口立即返回 201，构建结果可经项目详情（build=1）查询。\n路径别名：POST /rtfd/build/{name}；鉴权：项目 secret（未设置则免鉴权）",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "构建"
                ],
                "summary": "触发构建",
                "parameters": [
                    {
                        "type": "string",
                        "description": "项目名称",
                        "name": "name",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "分支或tag，缺省用项目最新版本",
                        "name": "branch",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "为 true/on/1 时输出完整构建日志（BuildWithAll）",
                        "name": "debug",
                        "in": "query"
                    }
                ],
                "responses": {
                    "201": {
                        "description": "已异步启动，branch 回显实际分支",
                        "schema": {
                            "$ref": "#/definitions/api.resb"
                        }
                    },
                    "default": {
                        "description": "项目不存在或签名校验失败",
                        "schema": {
                            "$ref": "#/definitions/api.res"
                        }
                    }
                }
            }
        },
        "/rtfd/{name}/desc": {
            "get": {
                "description": "返回项目 URL、语言、最新版本、可用版本、构建器、是否隐藏git等元数据，供文档页面浮动挂件（rtfd.js）渲染。\n无需鉴权。路径别名：GET /rtfd/desc/{name}",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "挂件"
                ],
                "summary": "获取项目描述",
                "parameters": [
                    {
                        "type": "string",
                        "description": "项目名称（不区分大小写）",
                        "name": "name",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "项目元数据，data.versions 为 {语言: [版本]} 映射",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/api.resd"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/api.descData"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "default": {
                        "description": "项目不存在或数据目录无效（success=false）",
                        "schema": {
                            "$ref": "#/definitions/api.res"
                        }
                    }
                }
            }
        },
        "/rtfd/{name}/export": {
            "get": {
                "security": [
                    {
                        "RtfdSign": []
                    }
                ],
                "description": "返回 base64 编码的项目配置，可通过导入接口或 CLI 在其它 rtfd 实例中还原。\nsysmeta=1 时保留系统 meta（如 _installation_id、_webhook_id）。需管理密钥或项目密钥。\n路径别名：GET /rtfd/export/{name}",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "项目管理"
                ],
                "summary": "导出项目配置",
                "parameters": [
                    {
                        "type": "string",
                        "description": "项目名称",
                        "name": "name",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "为 true/on/1 时保留系统 meta",
                        "name": "sysmeta",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "data.export 为 base64 配置",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/api.resd"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/api.exportData"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "default": {
                        "description": "项目不存在或密钥校验失败",
                        "schema": {
                            "$ref": "#/definitions/api.res"
                        }
                    }
                }
            }
        },
        "/rtfd/{name}/info": {
            "get": {
                "security": [
                    {
                        "RtfdSign": []
                    }
                ],
                "description": "默认返回项目完整配置；key 指定单个字段；build=1 时附带构建集。需管理密钥或项目密钥。\n路径别名：GET /rtfd/info/{name}",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "项目管理"
                ],
                "summary": "项目详情",
                "parameters": [
                    {
                        "type": "string",
                        "description": "项目名称",
                        "name": "name",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "字段名，如 lang、secret、url，返回 data.{key,value}",
                        "name": "key",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "为 true/on/1 时附带构建集（data.buildset）",
                        "name": "build",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "项目配置（key 时为 data.{key,value}）",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/api.resd"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/lib.OptionsWithResult"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "default": {
                        "description": "项目不存在或密钥校验失败",
                        "schema": {
                            "$ref": "#/definitions/api.res"
                        }
                    }
                }
            }
        },
        "/rtfd/{name}/remove": {
            "post": {
                "security": [
                    {
                        "RtfdSign": []
                    }
                ],
                "description": "删除项目配置、构建结果并移除对应的 nginx 配置。需管理密钥或项目密钥。\n路径别名：/rtfd/remove/{name}（POST 与 DELETE 均可）",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "项目管理"
                ],
                "summary": "删除项目",
                "parameters": [
                    {
                        "type": "string",
                        "description": "项目名称",
                        "name": "name",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "删除成功",
                        "schema": {
                            "$ref": "#/definitions/api.res"
                        }
                    },
                    "default": {
                        "description": "项目不存在或密钥校验失败",
                        "schema": {
                            "$ref": "#/definitions/api.res"
                        }
                    }
                }
            },
            "delete": {
                "security": [
                    {
                        "RtfdSign": []
                    }
                ],
                "description": "删除项目配置、构建结果并移除对应的 nginx 配置。需管理密钥或项目密钥。\n路径别名：/rtfd/remove/{name}（POST 与 DELETE 均可）",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "项目管理"
                ],
                "summary": "删除项目",
                "parameters": [
                    {
                        "type": "string",
                        "description": "项目名称",
                        "name": "name",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "删除成功",
                        "schema": {
                            "$ref": "#/definitions/api.res"
                        }
                    },
                    "default": {
                        "description": "项目不存在或密钥校验失败",
                        "schema": {
                            "$ref": "#/definitions/api.res"
                        }
                    }
                }
            }
        },
        "/rtfd/{name}/update": {
            "post": {
                "security": [
                    {
                        "RtfdSign": []
                    }
                ],
                "description": "三种传参方式（按优先级）：text（Field:Value 逗号分隔，sep 可自定义分隔符）、file（服务端 .rtfd.ini 路径，内容未变化则跳过）、\n或直接以字段名传参（如 lang=zh_CN\u0026single=on）。值 - 表示重置为空（requirement/index/secret）。\n字段名同创建项目；需管理密钥或项目密钥。路径别名：POST /rtfd/update/{name}",
                "consumes": [
                    "application/x-www-form-urlencoded"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "项目管理"
                ],
                "summary": "更新项目配置",
                "parameters": [
                    {
                        "type": "string",
                        "description": "项目名称",
                        "name": "name",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "更新规则，如 lang:zh_CN,single:on",
                        "name": "text",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "text 的字段分隔符，默认英文逗号",
                        "name": "sep",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "服务端规则文件路径（.rtfd.ini）",
                        "name": "file",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "直接传字段：见创建项目参数列表",
                        "name": "url",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "直接传字段：语言，如 en",
                        "name": "lang",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "直接传字段：是否单一版本",
                        "name": "single",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "直接传字段：分支或tag",
                        "name": "latest",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "直接传字段：Python 版本",
                        "name": "version",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "直接传字段：文档源目录",
                        "name": "sourcedir",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "直接传字段：依赖文件路径，- 重置",
                        "name": "requirement",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "直接传字段：是否安装依赖",
                        "name": "install",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "直接传字段：pip 源索引，- 重置",
                        "name": "index",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "直接传字段：Sphinx 构建器",
                        "name": "builder",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "直接传字段：项目密钥，- 重置",
                        "name": "secret",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "直接传字段：自定义域名，- 取消",
                        "name": "domain",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "直接传字段：证书路径（需与 sslkey 同时提供）",
                        "name": "sslcrt",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "直接传字段：证书私钥路径",
                        "name": "sslkey",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "直接传字段：是否显示挂件导航",
                        "name": "shownav",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "直接传字段：是否隐藏git入口",
                        "name": "hidegit",
                        "in": "formData"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "更新结果，updated/failed 为字段列表；规则文件内容未变化时 updated/failed 为空且 message=not updated",
                        "schema": {
                            "$ref": "#/definitions/api.resup"
                        }
                    },
                    "default": {
                        "description": "项目不存在、规则为空或密钥校验失败",
                        "schema": {
                            "$ref": "#/definitions/api.res"
                        }
                    }
                }
            }
        },
        "/rtfd/{name}/webhook": {
            "post": {
                "description": "接收 GitHub（校验 X-Hub-Signature HMAC-SHA1）与 Gitee（校验 X-Gitee-Token）的 push/release 事件，\n校验通过后异步构建；ping 事件直接返回 pong；命中项目 meta 的 excluded_branch 时忽略。\n路径别名：POST /rtfd/webhook/{name}",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "webhook"
                ],
                "summary": "git仓库webhook",
                "parameters": [
                    {
                        "type": "string",
                        "description": "项目名称",
                        "name": "name",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "ping 事件回 pong（success=true，ping=pong）",
                        "schema": {
                            "$ref": "#/definitions/api.resp"
                        }
                    },
                    "201": {
                        "description": "已异步启动构建（命中 excluded_branch 时返回 200 且 success=false）",
                        "schema": {
                            "$ref": "#/definitions/api.resb"
                        }
                    },
                    "default": {
                        "description": "来源、事件类型或签名校验失败",
                        "schema": {
                            "$ref": "#/definitions/api.res"
                        }
                    }
                }
            }
        }
    },
